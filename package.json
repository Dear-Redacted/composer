{
  "name": "composer",
  "author": "J. Redacted",
  "description": "A new text editor that censors you",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:renderer\" \"npm:dev:electron\"",
    "dev:renderer": "vite --port=3000",
    "dev:electron": "wait-on http://127.0.0.1:3000 && cross-env ELECTRON_RENDERER_URL=http://127.0.0.1:3000 electron electron/main.cjs",
    "build": "npm run clean && npm run build:web && electron-builder --config electron-builder.config.cjs",
    "build:web": "vite build",
    "build:analyze": "cross-env ANALYZE=true vite build",
    "prebuild:desktop": "npm run build:web",
    "build:desktop": "electron-builder --config electron-builder.config.cjs",
    "release:desktop": "npm run build:desktop",
    "audit:desktop-size": "node scripts/audit-desktop-size.mjs release",
    "preview": "vite preview",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true});require('fs').rmSync('release',{recursive:true,force:true})\"",
    "clean:web": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "clean:desktop": "node -e \"require('fs').rmSync('release',{recursive:true,force:true})\"",
    "lint": "tsc --noEmit && eslint --ext .ts,.tsx,.cjs src electron",
    "lint:fix": "eslint --ext .ts,.tsx,.cjs src electron --fix",
    "format": "prettier --write src electron test docs",
    "format:check": "prettier --check src electron test docs",
    "test": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:speed": "playwright test test/e2e/redaction-speed.spec.ts",
    "test:e2e:fast": "playwright test test/e2e/redaction-speed.spec.ts -g \"typing speed: fast\"",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@playwright/test": "^1.39.0",
    "@tailwindcss/vite": "^4.1.14",
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.59.1",
    "@typescript-eslint/parser": "^8.59.1",
    "@vitejs/plugin-react": "^5.0.4",
    "@vitest/coverage-v8": "^4.1.5",
    "autoprefixer": "^10.4.21",
    "concurrently": "^9.2.1",
    "cross-env": "^10.0.0",
    "electron": "^41.3.0",
    "electron-builder": "^26.8.1",
    "eslint": "^8.56.0",
    "eslint-plugin-react": "^7.33.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "jsdom": "^29.1.0",
    "prettier": "^3.1.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "rollup-plugin-visualizer": "^7.0.1",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^8.0.11",
    "vitest": "^4.1.5",
    "wait-on": "^8.0.3"
  }
}
